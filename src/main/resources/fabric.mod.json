{
	"schemaVersion": 1,
	"id": "spb-revamped",
	"version": "${version}",
	"name": "SP-Backrooms Revamped",
	"description": "Spacepotato's Found Footage Mod - Updated by Minheur",
	"authors": [
		"SpacePotato",
		"Herr Chaos",
		"MetaOne - Russian Translation",
		"Min_heur2000 - those updates"
	],
	"contact": {
		"YouTube - SpacePotatoes": "https://www.youtube.com/@SpacePotatoee"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/spb-revamped/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "net.minheur.SPBRevamped"
		],
		"client": [
          "net.minheur.SPBRevampedClient"
		],
		"fabric-datagen": [
          "net.minheur.SPBRevampedDataGenerator"
		],
		"cardinal-components": [
			"net.minheur.cca_stuff.InitializeComponents"
		],
		"modmenu": [
			"net.minheur.init.ModMenuMenu"
		],
		"voicechat": [
			"net.minheur.sounds.voicechat.BackroomsVoicechatPlugin"
		]
	},
	"custom": {
		"cardinal-components": [
			"spb-revamped:player",
			"spb-revamped:events",
			"spb-revamped:skw",
			"spb-revamped:smi"
		],
		"modmenu": {
			"links": {
				"My Youtube": "https://www.youtube.com/@SpacePotatoee",
				"Join SpacePotatoes Discord!": "https://discord.gg/z3sfGTdjEn",
				"Join Minheur2000's Discord!": "https://discord.gg/2hmSmmnA4R"
			},
			"update_checker": false
		}
	},
	"mixins": [
		"spb-revamped.mixins.json"
	],
	"accessWidener": "spb-revamped.accesswidener",
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"fabric-key-binding-api-v1": "*",
		"voicechat": ">=1.20.1-2.4.32",
		"geckolib": ">=4.4.9"
	},
	"suggests": {
		"mod-menu": "*",
		"essential": "*",
		"camerapture": "*"
	},
	"breaks": {
		"sodium": "*",
		"create": "*",
		"iris": "*",
		"optifine": "*",
		"lithium": "*",
		"phosphor": "*",
		"indium": "*",
		"modern_industrialization": "*"
	}
}
